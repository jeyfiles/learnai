{
  "name": "jeyinsights-learnai",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "JeyInsights Learn AI: a free, self-paced AI learning portal for people building a career in AI. Served at jeyinsights.com/learnai.",
  "author": "Jeyadev",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check:copy": "node scripts/check-copy.mjs",
    "build": "astro build && node scripts/check-copy.mjs && node scripts/audit-site.mjs && node scripts/report-size.mjs",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "serve:dist": "node scripts/serve-dist.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "audit": "node scripts/audit-site.mjs",
    "check:live": "node scripts/check-live.mjs",
    "build:pages": "npm run build && node scripts/pages-output.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@types/js-yaml": "^4.0.9",
    "chrome-launcher": "^1.2.1",
    "js-yaml": "^5.4.2",
    "lighthouse": "^13.5.0",
    "vitest": "^5.0.2"
  }
}
