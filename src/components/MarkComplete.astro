---
// Lets a learner mark an item as done. Saved on this device only.
interface Props { item: string; label?: string }
const { item, label = 'Mark this lesson as done' } = Astro.props;
---
<div class="la-complete la-no-print" data-complete={item}>
  <button class="la-btn la-btn--primary" type="button" aria-pressed="false">
    <span data-label>{label}</span>
  </button>
  <p class="la-meta" data-note>Saved only on this device.</p>
</div>

<script>
  import { isDone, setDone } from '../lib/storage';
  document.querySelectorAll<HTMLElement>('[data-complete]').forEach((wrap) => {
    const item = wrap.dataset.complete as string;
    const btn = wrap.querySelector('button') as HTMLButtonElement;
    const label = wrap.querySelector('[data-label]') as HTMLElement;
    const original = label.textContent ?? '';
    const render = (done: boolean) => {
      btn.setAttribute('aria-pressed', String(done));
      label.textContent = done ? 'Done. Click to undo' : original;
      btn.classList.toggle('is-done', done);
    };
    render(isDone(item));
    btn.addEventListener('click', () => render(setDone(item, btn.getAttribute('aria-pressed') !== 'true').done.includes(item)));
  });
</script>

<style>
  .la-complete { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ji-s-3); margin-top: var(--ji-s-6); }
  .la-complete p { margin: 0; }
  .la-complete .is-done { background: var(--ji-success); }
</style>
